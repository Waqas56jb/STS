# Copy to .env and fill in. See README.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,https://www.stsq8.com,https://stsq8.com

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
APP_ENCRYPTION_KEY=change-me-64-hex-chars-32-bytes

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123!
ADMIN_NAME=STS Admin
# Existing customer tenants are attached to this admin; every other admin starts empty.
PLATFORM_ADMIN_EMAIL=admin@stsq8.com

# WhatsApp QR (Baileys) — persistent disk required (Railway volume). Not for Vercel.
WHATSAPP_QR_ENABLED=true
WHATSAPP_QR_SESSION_DIR=

# OpenAI — powers all agents + long-term customer memory summarization
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta webhooks (optional global verify tokens; per-business tokens also work)
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# Vonage Voice (platform — also configurable in Admin → Settings → Voice)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_APPLICATION_ID=
# Public URLs for webhooks/websocket (Railway production)
VOICE_PUBLIC_BASE_URL=https://sts-production-85ff.up.railway.app
VONAGE_PUBLIC_WS_URL=wss://sts-production-85ff.up.railway.app/vonage-stream
