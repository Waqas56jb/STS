# Copy to .env and fill in. See README.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,https://www.stsq8.com,https://stsq8.com

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
APP_ENCRYPTION_KEY=change-me-64-hex-chars-32-bytes

# Admin login is stored in the database only (sts_users).
# Create / rotate with:  node scripts/set-admin.js <email> <password>
# Optional env overrides (usually leave unset):
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_EMAILS=
# ADMIN_EMAIL=   (seed script only)

# WhatsApp QR (Baileys) — persistent disk required (Railway volume). Not for Vercel.
WHATSAPP_QR_ENABLED=true
# Local dev: keep false so localhost does NOT steal the production WhatsApp session on Railway.
# Railway auto-enables restore when RAILWAY_PUBLIC_DOMAIN is set.
WHATSAPP_QR_AUTO_RESTORE=false
# Local: leave empty (uses server/.whatsapp-sessions). Railway: attach a volume; optional override:
WHATSAPP_QR_SESSION_DIR=
# Railway sets these automatically when a volume is mounted:
# RAILWAY_VOLUME_MOUNT_PATH=/data
# RAILWAY_PUBLIC_DOMAIN=sts-production-85ff.up.railway.app

# OpenAI — powers all agents + long-term customer memory summarization
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta webhooks (optional global verify tokens; per-business tokens also work)
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# Vonage Voice (platform — also configurable in Admin → Settings → Voice)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_APPLICATION_ID=
# Public URLs for webhooks/websocket — required for Vonage/Meta to reach your server.
# Local coding: leave empty (UI shows http://localhost:4000/...). Vonage cannot call localhost.
# Railway production: set to your Railway URL (or rely on RAILWAY_PUBLIC_DOMAIN):
VOICE_PUBLIC_BASE_URL=
VONAGE_PUBLIC_WS_URL=
# Optional bind address (Railway default 0.0.0.0 is set in code)
# HOST=0.0.0.0

# ---- Email (Resend OR SMTP) ----
# Option A — Resend (recommended):
# RESEND_API_KEY=re_xxx
# MAIL_FROM=STS <noreply@yourdomain.com>
# Option B — SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM=STS <noreply@yourdomain.com>
CLIENT_APP_URL=https://www.stsq8.com
ADMIN_APP_URL=https://sts-admin-roan.vercel.app
